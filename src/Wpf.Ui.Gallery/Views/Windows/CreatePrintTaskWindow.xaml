<ui:FluentWindow
    x:Class="Wpf.Ui.Gallery.Views.Windows.CreatePrintTaskWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.Gallery.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:dialog="clr-namespace:Wpf.Ui.Gallery.Views.Windows"
    mc:Ignorable="d"
    Title="创建打印任务"
    MinHeight="250"
    MinWidth="600"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
>
    <local:CreatePrintTaskDialog DataContext="{Binding}" />
</ui:FluentWindow>