<UserControl
    x:Class="Wpf.Ui.Gallery.Views.Windows.CreatePrintTaskDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.Gallery.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:Wpf.Ui.Gallery.Converters"
    xmlns:printTask="clr-namespace:Wpf.Ui.Gallery.LocalConfig"
    xmlns:orderTrack="clr-namespace:Wpf.Ui.Gallery.Constant"
    mc:Ignorable="d"
    MinHeight="400"
    MinWidth="600">
    <UserControl.Resources>
        <converters:InvertBooleanConverter x:Key="InvertBooleanConverter" />
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
    <StackPanel>
        <TextBlock Text="将要打印以下生产计划:" />
        <TextBlock Text="{Binding ProduceBatchNumbersText}" Margin="0,10" TextWrapping="Wrap" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                Grid.Column="0"
                Text="{Binding DestinationFolder, Mode=TwoWay}"
                IsReadOnly="True"
                VerticalAlignment="Center" />
            <Button
                Grid.Column="1"
                Content="选择印花图存放的临时文件夹"
                Command="{Binding SelectFolderCommand}"
                Margin="10,0,0,0" />
        </Grid>
        <TextBlock Text="输出格式:" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
            <RadioButton Content=".png(RGBA)" IsChecked="{Binding OutputFormatOb, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static printTask:OutputFormat.Png}}" />
            <RadioButton Content=".jpg(RGB)" IsChecked="{Binding OutputFormatOb, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static printTask:OutputFormat.Jpg}}" Margin="10,0,0,0" />
            <RadioButton Content=".tif(CYMK)" IsEnabled="{Binding IsTifFormatEnabled}" IsChecked="{Binding OutputFormatOb, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static printTask:OutputFormat.TifCymk}}" Margin="10,0,0,0" />
            <RadioButton Content=".tif(CYMK+专色通道)" IsEnabled="{Binding IsTifFormatEnabled}" IsChecked="{Binding OutputFormatOb, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static printTask:OutputFormat.TifWithSpotColor}}" Margin="10,0,0,0" />
        </StackPanel>

        <TextBlock Text="排版:" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
            <RadioButton Content="自动排版" IsChecked="{Binding LayoutOptionOb, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static printTask:LayoutOption.Automatic}}" />
            <RadioButton Content="不排版(后续手动排版)" IsEnabled="{Binding IsManualLayoutEnabled}"  IsChecked="{Binding LayoutOptionOb, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static printTask:LayoutOption.Manual}}" Margin="10,0,0,0" />
        </StackPanel>
        
        <TextBlock Text="加打跟踪条:" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
            <RadioButton Content="不打印跟踪条" IsChecked="{Binding OrderTrackTypeOb, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static orderTrack:OrderTrackType.不打印跟踪条}}" />
            <RadioButton Content="打印详细跟踪条" IsChecked="{Binding OrderTrackTypeOb, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static orderTrack:OrderTrackType.打印详细跟踪条}}" Margin="10,0,0,0" />
            <RadioButton Content="打印简短信息" IsEnabled="False" IsChecked="{Binding OrderTrackTypeOb, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static orderTrack:OrderTrackType.打印简短信息}}" Margin="10,0,0,0" />
            <RadioButton Content="仅打印跟踪码" IsEnabled="False" IsChecked="{Binding OrderTrackTypeOb, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static orderTrack:OrderTrackType.仅打印跟踪码}}" Margin="10,0,0,0" />
        </StackPanel>
        <ProgressBar Value="{Binding CopyProgress}" Margin="0,10" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button
                Content="制作印刷生产图"
                Command="{Binding ConvertFormat2printCommand}"
                IsEnabled="{Binding IsExecuting, Converter={StaticResource InvertBooleanConverter}}"
                Margin="0,0,10,0" />
            <!--<Button
                Content="开始批量打印"
                Command="{Binding StartBatchPrintCommand}"
                IsEnabled="{Binding IsPrintButtonEnabled}" />-->
            <Button
                Content="打开目标文件夹"
                Command="{Binding OpenTargetFolderCommand}"
                IsEnabled="{Binding IsPrintButtonEnabled}" />
        </StackPanel>
    </StackPanel>
        <Button
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Command="{Binding OpenSettingsDialogCommand}">
            <ui:SymbolIcon Symbol="Settings24" />
        </Button>
        <ui:ProgressRing
            IsIndeterminate="True"
            Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVisibilityConverter}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
    </Grid>
</UserControl>
