<UserControl
    x:Class="Wpf.Ui.Gallery.Views.Pages.CreatePrintTaskDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.Gallery.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:Wpf.Ui.Gallery.Converters"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:InvertBooleanConverter x:Key="InvertBooleanConverter" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="将要打印以下生产计划:" />
        <ListBox ItemsSource="{Binding ProduceBatchNumbers}" Margin="0,10" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                Grid.Column="0"
                Text="{Binding DestinationFolder, Mode=TwoWay}"
                IsReadOnly="True"
                VerticalAlignment="Center" />
            <Button
                Grid.Column="1"
                Content="选择文件夹"
                Command="{Binding SelectFolderCommand}"
                Margin="10,0,0,0" />
        </Grid>
        <ProgressBar Value="{Binding CopyProgress}" Margin="0,10" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button
                Content="执行"
                Command="{Binding ExecuteCommand}"
                IsEnabled="{Binding IsExecuting, Converter={StaticResource InvertBooleanConverter}}"
                Margin="0,0,10,0" />
            <Button
                Content="开始批量打印"
                Command="{Binding StartBatchPrintCommand}"
                IsEnabled="{Binding IsPrintButtonEnabled}" />
        </StackPanel>
    </StackPanel>
</UserControl>