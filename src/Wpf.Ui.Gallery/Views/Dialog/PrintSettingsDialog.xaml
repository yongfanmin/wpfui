<UserControl
    x:Class="Wpf.Ui.Gallery.Views.Dialog.PrintSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.Gallery.Views.Dialog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewmodels="clr-namespace:Wpf.Ui.Gallery.ViewModels.Dialog"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance viewmodels:PrintSettingsDialogViewModel, IsDesignTimeCreatable=False}">
    <StackPanel Width="300">
        <TextBlock Margin="0,0,0,8" Text="打印机宽度 (毫米)" />
        <ui:TextBox Margin="0,0,0,16" Text="{Binding PrintTaskConfig.MachinePrintWidthMm, Mode=TwoWay}" />
        <TextBlock Margin="0,0,0,8" Text="印刷左右安全边距 (毫米)" />
        <ui:TextBox Margin="0,0,0,16" Text="{Binding PrintTaskConfig.MachinePrintSafeEdgeMm, Mode=TwoWay}" />
        <TextBlock Margin="0,0,0,8" Text="印花排版间距 (毫米)" />
        <ui:TextBox Margin="0,0,0,16" Text="{Binding PrintTaskConfig.PrintImgPaddingMm, Mode=TwoWay}" />
        <TextBlock Margin="0,0,0,8" Text="白墨烫画专色通道内缩量 (像素)" />
        <ui:TextBox Margin="0,0,0,16" Text="{Binding PrintTaskConfig.WhiteInkBleedPx, Mode=TwoWay}" />
    </StackPanel>
</UserControl>