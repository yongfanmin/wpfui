<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.ProcessStepScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.Gallery.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="ProcessStepScanPage"
    d:DataContext="{d:DesignInstance local:ProcessStepScanPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    FocusManager.FocusedElement="{Binding ElementName=BatchNoTextBox}">
    <Page.Resources>
        <Style x:Key="SelectableReadOnlyCellStyle" TargetType="{x:Type TextBox}">
            <!-- 1. 核心：设为只读 -->
            <Setter Property="IsReadOnly" Value="True" />

            <!-- 2. 外观：让它看起来完全像一个普通的TextBlock，并且颜色跟随主题 -->
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <!-- 核心修改：使用WPF UI的主题画刷来设置文字颜色 -->
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    
            <!-- 3. 行为：优化交互体验 -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <!-- 改进1：使用主题感知的选区颜色，而不是系统默认的蓝色 -->
            <Setter Property="SelectionBrush" Value="{DynamicResource TextControlSelectionHighlightColorBrush}" />
            <!-- 改进2：隐藏只读文本框中无用的闪烁光标 -->
            <Setter Property="CaretBrush" Value="Transparent" />
    
            <!-- 4. 布局：保持原有的良好对齐方式 -->
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style BasedOn="{StaticResource {x:Type TabItem}}" TargetType="TabItem">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Panel.ZIndex" Value="100" />
                    <Setter Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ui:SymbolIcon">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <Grid>
    <TabControl x:Name="TabControl" Margin="0,8,0,0" SelectedIndex="{Binding ViewModel.SelectedTabIndex, Mode=TwoWay}">
        <TabItem IsSelected="True">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="0,0,6,0" Symbol="DrawImage24" />
                    <TextBlock Text="开始印花生产" />
                </StackPanel>
            </TabItem.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Row="0"
                    Margin="0,12,0,12"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:TextBox
                        Name="BatchNoStartBox"
                        Width="300"
                        Margin="0,0,12,0"
                        FontWeight="Bold"
                        PlaceholderText="输入工位批次号"
                        Text="{Binding ViewModel.StartProduceBatchNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Margin="10,0,0,0"
                        Command="{Binding ViewModel.EnterConfirmStartProduceCommand}"
                        Content="开始生产" />
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                            Grid.Row="0"
                            Margin="0,0,8,0"
                            Padding="12"
                            Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="生产批次: " />
                                    <TextBox Grid.Column="1" VerticalAlignment="Center" TextAlignment="Left" Style="{StaticResource SelectableReadOnlyCellStyle}"  Text="{Binding ViewModel.StartProduceItemScanResult.ProduceBatchNum}" />
                                    <ui:Button Grid.Column="2"
                                        Command="{Binding ViewModel.SetProduceCommand}"
                                        CommandParameter="{Binding ViewModel.StartProduceItemScanResult.ProduceBatchNum}"
                                        Content="整批开始生产" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="项批次: " />
                                    <TextBox Grid.Column="1" VerticalAlignment="Center" TextAlignment="Left" Style="{StaticResource SelectableReadOnlyCellStyle}" Text="{Binding ViewModel.StartProduceItemScanResult.BatchNo}" />
                                    <!--<ui:Button Grid.Column="2"
                                        Command="{Binding ViewModel.SetProduceCommand}"
                                        CommandParameter="{Binding ViewModel.CurrentProductionItem.BatchNo}"
                                        Content="复制" />-->
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="工位批次: " />
                                    <TextBox Grid.Column="1" VerticalAlignment="Center" TextAlignment="Left" Style="{StaticResource SelectableReadOnlyCellStyle}" Text="{Binding ViewModel.StartProduceItemScanResult.ItemId}" />
                                    <!--<ui:Button Grid.Column="2"
                                        Command="{Binding ViewModel.SetProduceCommand}"
                                        CommandParameter="{Binding ViewModel.CurrentProductionItem.ItemId}"
                                        Content="复制" />-->
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border
                            Grid.Row="1"
                            Margin="0,8,8,0"
                            Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <ui:Image Stretch="Uniform" CornerRadius="4" BorderBrush="#33000000" Source="{Binding ViewModel.StartProducePrintLayerImgView}"/>
                        </Border>
                    </Grid>
                    <ListView
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        ItemsSource="{Binding ViewModel.StartProduceItemList}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn DisplayMemberBinding="{Binding ProduceBatchNum}" Header="生产批次" />
                                <GridViewColumn DisplayMemberBinding="{Binding BatchNo}" Header="项批次" />
                                <GridViewColumn DisplayMemberBinding="{Binding ItemId}" Header="工位批次" />
                                <GridViewColumn Header="状态">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="生产中" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="0,0,6,0" Symbol="BoxMultipleCheckmark24" />
                    <TextBlock Text="生产完成" />
                </StackPanel>
            </TabItem.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Row="0"
                    Margin="0,12,0,12"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:TextBox
                        Name="BatchNoCompleteBox"
                        Width="300"
                        Margin="0,0,12,0"
                        FontWeight="Bold"
                        PlaceholderText="输入项批次号"
                        Text="{Binding ViewModel.CompleteProduceBatchNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Margin="10,0,0,0"
                        Command="{Binding ViewModel.EnterConfirmCompleteProduceCommand}"
                        Content="生产完成" />
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                            Grid.Row="0"
                            Margin="0,0,8,0"
                            Padding="12"
                            Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="生产批次: " />
                                    <TextBox Grid.Column="1" VerticalAlignment="Center" TextAlignment="Left" Style="{StaticResource SelectableReadOnlyCellStyle}"  Text="{Binding ViewModel.CompleteProduceItemScanResult.ProduceBatchNum}" />
                                    <ui:Button Grid.Column="2"
                                        Command="{Binding ViewModel.SetProduceCommand}"
                                        CommandParameter="{Binding ViewModel.CompleteProduceItemScanResult.ProduceBatchNum}"
                                        Content="整批完成生产" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="项批次: " />
                                    <TextBox Grid.Column="1" VerticalAlignment="Center" TextAlignment="Left" Style="{StaticResource SelectableReadOnlyCellStyle}" Text="{Binding ViewModel.CompleteProduceItemScanResult.BatchNo}" />
                                    <!--<ui:Button Grid.Column="2"
                                        Command="{Binding ViewModel.SetProduceCommand}"
                                        CommandParameter="{Binding ViewModel.CurrentProductionItem.BatchNo}"
                                        Content="复制" />-->
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="工位批次: " />
                                    <TextBox Grid.Column="1" VerticalAlignment="Center" TextAlignment="Left" Style="{StaticResource SelectableReadOnlyCellStyle}" Text="{Binding ViewModel.CompleteProduceItemScanResult.ItemId}" />
                                    <!--<ui:Button Grid.Column="2"
                                        Command="{Binding ViewModel.SetProduceCommand}"
                                        CommandParameter="{Binding ViewModel.CurrentProductionItem.ItemId}"
                                        Content="复制" />-->
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border
                            Grid.Row="1"
                            Margin="0,8,8,0"
                            Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <ui:Image Stretch="Uniform" CornerRadius="4" BorderBrush="#33000000" Source="{Binding ViewModel.CompleteProducePrintLayerImgView}"/>
                        </Border>
                    </Grid>
                    <ListView
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        ItemsSource="{Binding ViewModel.CompleteProduceItemList}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn DisplayMemberBinding="{Binding ProduceBatchNum}" Header="生产批次" />
                                <GridViewColumn DisplayMemberBinding="{Binding BatchNo}" Header="项批次" />
                                <GridViewColumn DisplayMemberBinding="{Binding ItemId}" Header="工位批次" />
                                <GridViewColumn Header="状态">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="生产完成" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
    <ui:Button
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Margin="0,0,18,0"
        Appearance="Transparent"
        Command="{Binding ViewModel.OpenSettingsDialogCommand}"
        Panel.ZIndex="2">
        <ui:SymbolIcon FontSize="20" Symbol="Settings24" />
    </ui:Button>
    </Grid>
</Page>