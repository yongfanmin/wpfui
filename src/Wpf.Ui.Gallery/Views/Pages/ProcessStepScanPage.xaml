<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.ProcessStepScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.Gallery.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="ProcessStepScanPage"
    d:DataContext="{d:DesignInstance local:ProcessStepScanPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    FocusManager.FocusedElement="{Binding ElementName=BatchNoTextBox}">

    <Page.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding ViewModel.EnterConfirmCommand}" />
    </Page.InputBindings>
    <TabControl Margin="0,8,0,0">
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="0,0,6,0" Symbol="DrawImage24" />
                    <TextBlock Text="开始印花生产" />
                </StackPanel>
            </TabItem.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel 
                    Grid.Row="0" 
                    Margin="0,12,0,12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:TextBox
                        Name="BatchNoStartBox"
                        FontWeight="Bold"
                        Width="200"
                        Margin="0,0,12,0"
                        PlaceholderText="输入工位批次号"
                        Text="{Binding ViewModel.BatchNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Margin="10,0,0,0"
                        Command="{Binding ViewModel.EnterConfirmStartProduceCommand}"
                        Content="开始生产" />
                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem IsSelected="True">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="0,0,6,0" Symbol="BoxMultipleCheckmark24" />
                    <TextBlock Text="生产完成" />
                </StackPanel>
            </TabItem.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel 
                    Grid.Row="0" 
                    Margin="0,12,0,12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:TextBox
                        Name="BatchNoCompleteBox"
                        FontWeight="Bold"
                        Width="200"
                        Margin="0,0,12,0"
                        PlaceholderText="输入项批次号"
                        Text="{Binding ViewModel.BatchNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Margin="10,0,0,0"
                        Command="{Binding ViewModel.EnterConfirmCompleteProduceCommand}"
                        Content="生产完成" />
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</Page>