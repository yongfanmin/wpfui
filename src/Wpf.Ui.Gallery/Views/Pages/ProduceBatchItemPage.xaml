<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.ProduceBatchItemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.Gallery.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:utils="clr-namespace:Wpf.Ui.Gallery.Utils"
    x:Name="ProduceBatchItemPageRoot"
    Title="ProduceBatchPage"
    d:DataContext="{d:DesignInstance local:ProduceBatchItemPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Page.Resources>
        <utils:BindingProxy x:Key="Proxy" Data="{Binding ElementName=ProduceBatchItemPageRoot}" />
        <Style x:Key="DataGridRowStyleWithContextMenu" TargetType="{x:Type DataGridRow}">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
            <Setter Property="ValidationErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <ui:SymbolIcon
                            Margin="-4,0,-12,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Width="24"
                            Height="24"
                            Symbol="ErrorCircle12" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridRow}">
                        <Border
                            x:Name="DGR_Border"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                            <SelectiveScrollingGrid>
                                <SelectiveScrollingGrid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </SelectiveScrollingGrid.ColumnDefinitions>
                                <SelectiveScrollingGrid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </SelectiveScrollingGrid.RowDefinitions>
                                <DataGridCellsPresenter
                                    Grid.Column="1"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                <DataGridDetailsPresenter
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                    Visibility="{TemplateBinding DetailsVisibility}" />
                                <DataGridRowHeader
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="0"
                                    SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
                                    Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Row}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                                <Rectangle
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    x:Name="ActiveRectangle"
                                    Width="3"
                                    Height="18"
                                    Margin="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Fill="{DynamicResource ListViewItemPillFillBrush}"
                                    RadiusX="2"
                                    RadiusY="2"
                                    Visibility="Collapsed" />
                            </SelectiveScrollingGrid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="AlternationIndex" Value="0">
                                <Setter TargetName="DGR_Border" Property="Background" Value="{Binding RowBackground, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                            </Trigger>
                            <Trigger Property="AlternationIndex" Value="1">
                                <Setter TargetName="DGR_Border" Property="Background" Value="{Binding AlternatingRowBackground, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}" />
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ActiveRectangle" Property="Visibility" Value="Visible" />
                                <Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- 重置项批号 需要在软件端 单独获取此项批号数据 然后在软件端重新生产 不走获取生产计划的统一流程 -->
            <!--<Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="重置生产"
                                  Tag="ResetMenuItem"
                                  Command="{Binding Data.ViewModel.ResetProductionAsyncCommand, Source={StaticResource Proxy}}" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>-->
            <EventSetter Event="ContextMenuOpening" Handler="DataGridRow_ContextMenuOpening"/>
        </Style>

        <Style x:Key="SelectableReadOnlyCellStyle" TargetType="{x:Type TextBox}">
            <!-- 1. 核心：设为只读 -->
            <Setter Property="IsReadOnly" Value="True" />

            <!-- 2. 外观：让它看起来完全像一个普通的TextBlock，并且颜色跟随主题 -->
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <!-- 核心修改：使用WPF UI的主题画刷来设置文字颜色 -->
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    
            <!-- 3. 行为：优化交互体验 -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <!-- 改进1：使用主题感知的选区颜色，而不是系统默认的蓝色 -->
            <Setter Property="SelectionBrush" Value="{DynamicResource TextControlSelectionHighlightColorBrush}" />
            <!-- 改进2：隐藏只读文本框中无用的闪烁光标 -->
            <Setter Property="CaretBrush" Value="Transparent" />
    
            <!-- 4. 布局：保持原有的良好对齐方式 -->
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <ui:TextBox
                x:Name="SearchProduceBatchBox"
                FontWeight="Bold"
                Width="300" Margin="0,0,12,0"
                PlaceholderEnabled="True"
                PlaceholderText="输入生产计划编号"
                Text="{Binding ViewModel.SelectedProduceBatchNumber, Mode=OneWay}" />
            <ui:TextBox
                x:Name="SearchItemBox"
                FontWeight="Bold"
                Width="200" Margin="0,0,12,0"
                PlaceholderEnabled="True"
                PlaceholderText="输入项批号"
                Text="{Binding ViewModel.SelectedBatchNum, Mode=TwoWay}" />
            <Button Command="{Binding ViewModel.SearchCommand}"
                    CommandParameter="{Binding Text, ElementName=SearchProduceBatchBox}" Content="搜索" />
        </StackPanel>
        <Border
            Grid.Row="1"
            Margin="0 12 0 0"
            Background="{ui:ThemeResource ApplicationBackgroundBrush}"
            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <ui:DataGrid
                x:Name="ProductBatchItemDataGrid"
                SelectionMode="Extended"
                Margin="0 12 0 0"
                ItemsSource="{Binding ViewModel.ProductBatchItemCollection, Mode=TwoWay}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                IsReadOnly="True"
                RowStyle="{StaticResource DataGridRowStyleWithContextMenu}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="项批号">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource SelectableReadOnlyCellStyle}"
                                         Text="{Binding BatchNum}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="单号">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource SelectableReadOnlyCellStyle}"
                                         Text="{Binding OrderNo}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="子单号">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource SelectableReadOnlyCellStyle}"
                                         Text="{Binding OrderDetailId}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="SKU">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource SelectableReadOnlyCellStyle}"
                                         Text="{Binding SkuAlias}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="订单状态" Binding="{Binding ProduceBatchItemProcess}" />
                    <DataGridTemplateColumn Header="操作">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="打开生产图"
                                        Command="{Binding ViewModel.OpenProduceItemCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ProduceBatchItemPage}}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </ui:DataGrid>
        </Border>
    </Grid>
</Page>