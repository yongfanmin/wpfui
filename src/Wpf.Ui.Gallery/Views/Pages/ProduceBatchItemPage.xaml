<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.ProduceBatchItemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.Gallery.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="ProduceBatchPage"
    d:DataContext="{d:DesignInstance local:ProduceBatchItemPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="SelectableReadOnlyCellStyle" TargetType="{x:Type TextBox}">
            <!-- 1. 核心：设为只读 -->
            <Setter Property="IsReadOnly" Value="True" />

            <!-- 2. 外观：让它看起来完全像一个普通的TextBlock，并且颜色跟随主题 -->
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <!-- 核心修改：使用WPF UI的主题画刷来设置文字颜色 -->
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    
            <!-- 3. 行为：优化交互体验 -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <!-- 改进1：使用主题感知的选区颜色，而不是系统默认的蓝色 -->
            <Setter Property="SelectionBrush" Value="{DynamicResource TextControlSelectionHighlightColorBrush}" />
            <!-- 改进2：隐藏只读文本框中无用的闪烁光标 -->
            <Setter Property="CaretBrush" Value="Transparent" />
    
            <!-- 4. 布局：保持原有的良好对齐方式 -->
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <ui:TextBox
                x:Name="SearchTextBox"
                FontWeight="Bold"
                Width="300" Margin="0,0,12,0"
                PlaceholderEnabled="True"
                PlaceholderText="输入生产批次号"
                Text="{Binding ViewModel.SelectedProduceBatchNumber, Mode=OneWay}" />
            <Button Command="{Binding ViewModel.SearchCommand}"
                    CommandParameter="{Binding Text, ElementName=SearchTextBox}" Content="搜索" />
        </StackPanel>
        <Border
            Grid.Row="1"
            Margin="0 12 0 0"
            Background="{ui:ThemeResource ApplicationBackgroundBrush}"
            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <ui:DataGrid
                Margin="0 12 0 0"
                ItemsSource="{Binding ViewModel.ProductBatchItemCollection, Mode=TwoWay}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="项批号">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource SelectableReadOnlyCellStyle}"
                                         Text="{Binding BatchNum}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="单号">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource SelectableReadOnlyCellStyle}"
                                         Text="{Binding OrderNo}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="产品名">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource SelectableReadOnlyCellStyle}"
                                         Text="{Binding SkuAlias}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="订单状态" Binding="{Binding ProduceBatchItemProcess}" />
                    <DataGridTemplateColumn Header="操作">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="打开生产图"
                                        Command="{Binding ViewModel.OpenProduceItemCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ProduceBatchItemPage}}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </ui:DataGrid>
        </Border>
    </Grid>
</Page>