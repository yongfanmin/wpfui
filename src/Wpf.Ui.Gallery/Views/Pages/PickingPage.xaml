<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.PickingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.Gallery.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Picking Page"
    d:DataContext="{d:DesignInstance local:PickingPage, IsDesignTimeCreatable=False}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Content="清空分拣篮" Command="{Binding ViewModel.ClearBasketCommand}" CommandParameter="{Binding ElementName=PickingListView, Path=SelectedItems}" Margin="0,0,8,0" />
                <Button Content="打印发货单" Command="{Binding ViewModel.PrintDeliveryBillCommand}" CommandParameter="{Binding ElementName=PickingListView, Path=SelectedItems}" />
            </StackPanel>
        </Grid>
        <ui:Button
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,0,18,0"
            Appearance="Transparent"
            Command="{Binding ViewModel.OpenSettingsDialogCommand}"
            Panel.ZIndex="2">
            <ui:SymbolIcon FontSize="20" Symbol="Settings24" />
        </ui:Button>
        <ListView
            x:Name="PickingListView"
            Grid.Row="1"
            ItemsSource="{Binding OrderPickBasketList}"
            SelectionMode="Multiple">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPicked}" Value="True">
                            <Setter Property="Background" Value="LightGreen" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="分拣篮编号">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Cart24" />
                                    <TextBlock Text="{Binding BasketNumber}" Margin="8,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="订单编号" DisplayMemberBinding="{Binding OrderNo}" />
                    <GridViewColumn Header="已分拣" DisplayMemberBinding="{Binding PickCount}" />
                    <GridViewColumn Header="总数" DisplayMemberBinding="{Binding ItemCount}" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>
