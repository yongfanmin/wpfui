<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.PickingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.Gallery.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:utils="clr-namespace:Wpf.Ui.Gallery.Utils"
    Title="Picking Page"
    d:DataContext="{d:DesignInstance local:PickingPage, IsDesignTimeCreatable=False}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">
    <Page.Resources>
        <utils:BindingProxy x:Key="Proxy" Data="{Binding ViewModel}" />
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0 ,12, 12, 12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <ui:TextBox
                        Name="PickOrderCode"
                        Width="300"
                        Margin="0,0,12,0"
                        FontWeight="Bold"
                        PlaceholderText="输入订单编码/订单号"
                        Text="{Binding ViewModel.PickOrderCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Command="{Binding ViewModel.ConfirmPickCommand}" Content="拣货" />
                </StackPanel>
                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding ViewModel.ClearBasketCommand}"
                        CommandParameter="{Binding ElementName=PickingListView, Path=SelectedItems}"
                        Content="清空分拣篮" />
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding ViewModel.AdjustSortQuantityCommand}"
                        CommandParameter="{Binding ElementName=PickingListView, Path=SelectedItems}"
                        Content="调整分拣数" />
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding ViewModel.PrintDeliveryBillCommand}"
                        CommandParameter="{Binding ElementName=PickingListView, Path=SelectedItems}"
                        Content="打印发货单" />
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding ViewModel.SetStartDeliveryCommand}"
                        CommandParameter="{Binding ElementName=PickingListView, Path=SelectedItems}"
                        Content="确认发货" />
                </StackPanel>
            </StackPanel>

            <ui:Button
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Appearance="Transparent"
                Command="{Binding ViewModel.OpenSettingsDialogCommand}"
                Panel.ZIndex="2">
                <ui:SymbolIcon FontSize="20" Symbol="Settings24" />
            </ui:Button>
        </Grid>
        <ListView
            x:Name="PickingListView"
            Grid.Row="1"
            ItemsSource="{Binding ViewModel.OrderPickBasketList}"
            SelectionMode="Multiple">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="换其他空蓝" Command="{Binding Data.ReplaceBasketCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="清空分拣篮" Command="{Binding Data.ClearSingleBasketCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="打印发货单" Command="{Binding Data.PrintSingleDeliveryBillCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="上移位置" Command="{Binding Data.MoveUpCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="下移位置" Command="{Binding Data.MoveDownCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="分拣篮编号" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Cart24" />
                                    <TextBlock Margin="8,0,0,0" Text="{Binding BasketNumber}" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        FontWeight="Bold"
                                        Foreground="Green"
                                        Text="分拣完成">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPicked}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="订单编号" Width="200">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding OrderNo}" IsReadOnly="True" BorderThickness="0" Background="Transparent" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="已分拣"  Width="120" DisplayMemberBinding="{Binding PickCount}" />
                    <GridViewColumn Header="总数"  Width="120" DisplayMemberBinding="{Binding ItemCount}" />
                    <GridViewColumn Header="当前状态"  Width="120" DisplayMemberBinding="{Binding Status}" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>
