<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.Gallery.Views.Pages"
    xmlns:windows="clr-namespace:Wpf.Ui.Gallery.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
    xmlns:converters="clr-namespace:Wpf.Ui.Gallery.Converters"
    xmlns:vo="clr-namespace:Wpf.Ui.Gallery.Vo"
    xmlns:utils="clr-namespace:Wpf.Ui.Gallery.Utils"
    xmlns:localApp="clr-namespace:Wpf.Ui.Gallery"
    xmlns:constant="clr-namespace:Wpf.Ui.Gallery.Constant"
    x:Name="DashboardPageRoot"
    Title="Dashboard Page"
    Tag="{Binding ElementName=ProductBatchDataGrid, Path=SelectedItems}"
    Margin="0,0,0,0"
    d:DataContext="{d:DesignInstance local:DashboardPage,
                                     IsDesignTimeCreatable=False}"
    ScrollViewer.CanContentScroll="False"
    d:DesignHeight="650"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Page.Resources>
        <utils:BindingProxy x:Key="Proxy" Data="{Binding ElementName=DashboardPageRoot}" />
        <Style x:Key="DataGridRowStyleWithContextMenu" TargetType="{x:Type DataGridRow}">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
            <Setter Property="ValidationErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <ui:SymbolIcon
                            Margin="-4,0,-12,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Width="24"
                            Height="24"
                            Symbol="ErrorCircle12" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridRow}">
                        <Border
                            x:Name="DGR_Border"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                            <SelectiveScrollingGrid>
                                <SelectiveScrollingGrid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </SelectiveScrollingGrid.ColumnDefinitions>
                                <SelectiveScrollingGrid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </SelectiveScrollingGrid.RowDefinitions>
                                <DataGridCellsPresenter
                                    Grid.Column="1"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                <DataGridDetailsPresenter
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                    Visibility="{TemplateBinding DetailsVisibility}" />
                                <DataGridRowHeader
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="0"
                                    SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
                                    Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Row}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                                <Rectangle
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    x:Name="ActiveRectangle"
                                    Width="3"
                                    Height="18"
                                    Margin="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Fill="{DynamicResource ListViewItemPillFillBrush}"
                                    RadiusX="2"
                                    RadiusY="2"
                                    Visibility="Collapsed" />
                            </SelectiveScrollingGrid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="AlternationIndex" Value="0">
                                <Setter TargetName="DGR_Border" Property="Background" Value="{Binding RowBackground, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                            </Trigger>
                            <Trigger Property="AlternationIndex" Value="1">
                                <Setter TargetName="DGR_Border" Property="Background" Value="{Binding AlternatingRowBackground, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}" />
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ActiveRectangle" Property="Visibility" Value="Visible" />
                                <Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem 
                            Tag="CreatePrintTask"
                            Header="归类印花图"
                                  Command="{Binding Data.ViewModel.CreatePrintTaskCommand, Source={StaticResource Proxy}}" />
                        <MenuItem 
                            Tag="ResetProduction"
                            Header="重置生产"
                                  Command="{Binding Data.ViewModel.ResetProductionCommand, Source={StaticResource Proxy}}" />
                        
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <EventSetter Event="ContextMenuOpening" Handler="DataGridRow_ContextMenuOpening"/>
        </Style>

        <Style x:Key="SelectableReadOnlyCellStyle" TargetType="{x:Type TextBox}">
            <!-- 1. 核心：设为只读 -->
            <Setter Property="IsReadOnly" Value="True" />

            <!-- 2. 外观：让它看起来完全像一个普通的TextBlock，并且颜色跟随主题 -->
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <!-- 核心修改：使用WPF UI的主题画刷来设置文字颜色 -->
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    
            <!-- 3. 行为：优化交互体验 -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <!-- 改进1：使用主题感知的选区颜色，而不是系统默认的蓝色 -->
            <Setter Property="SelectionBrush" Value="{DynamicResource TextControlSelectionHighlightColorBrush}" />
            <!-- 改进2：隐藏只读文本框中无用的闪烁光标 -->
            <Setter Property="CaretBrush" Value="Transparent" />
    
            <!-- 4. 布局：保持原有的良好对齐方式 -->
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="MyGridViewHeaderStyle" TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Background" Value="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}" />

            <!-- 2. (可选) 设置前景/文字颜色 -->
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />

            <!-- 3. (可选) 移除鼠标悬浮时的背景色变化，让表头更“静态” -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CenteredGridViewColumnCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <converters:ProduceStatusToStringConverter x:Key="ProduceStatusConverter" />
        <converters:OrderProduceProcessConverter x:Key="OrderProduceProcessConverter" />
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Height="100"
            Background="{ui:ThemeResource ApplicationBackgroundBrush}"
            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="24"> <!-- 使用Padding来创建内部边距 -->

            <!-- 使用Grid作为双栏布局的基础 -->
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <!-- 
                第一列：宽度设为 "Auto"，它会自动适应内容的宽度。
                这对于“机器状态”这种标签+开关的组合很合适。
            -->
                    <ColumnDefinition Width="Auto" />

                    <!-- 
                第二列：宽度设为 "*"，它会占据所有剩余的空间。
                我们将排版测试按钮放在这里。
            -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 第一个元素：机器状态 -->
                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="机器状态:"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0" />
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Ellipse
                            Width="12" Height="12"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <!-- 1. 默认状态：灰色，完全不透明 -->
                                    <Setter Property="Fill" Value="Gray" />
                                    <Setter Property="Opacity" Value="1.0" />

                                    <Style.Triggers>
                                        <!-- 规则 A: 静态颜色控制 -->
                                        <!-- 这个DataTrigger负责设置“接单中”的静态底色 -->
                                        <DataTrigger Binding="{Binding ViewModel.IsAcceptingOrders}" Value="True">
                                            <Setter Property="Fill" Value="DarkGreen" />
                                        </DataTrigger>

                                        <!-- 规则 B: 状态依赖的闪烁动画控制 -->
                                        <!-- 我们只在“接单中”且“网络活动中”这两个条件同时满足时，才触发闪烁 -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ViewModel.IsAcceptingOrders}" Value="True" />
                                                <Condition Binding="{Binding ViewModel.IsIndicatorBlinking}"
                                                           Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <!-- 
                            进入时，启动一个“红色闪烁”的动画。
                            这个动画是无限循环的。
                        -->
                                                <BeginStoryboard x:Name="Blinking_BeginStoryboard">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <ColorAnimation
                                                            Storyboard.TargetProperty="(Ellipse.Fill).(SolidColorBrush.Color)"
                                                            From="Yellow" To="LawnGreen"
                                                            Duration="0:0:0.3"
                                                            AutoReverse="True" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <!-- 
                            退出时（即IsIndicatorBlinking变为false），停止红色闪烁动画。
                            动画停止后，Fill属性的控制权会释放，
                            WPF会自动应用规则A的Setter，颜色恢复为LightGreen。
                        -->
                                                <StopStoryboard BeginStoryboardName="Blinking_BeginStoryboard" />
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>

                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </StackPanel>
                    <ui:ToggleSwitch
                        OffContent="停机"
                        OnContent="接单中"
                        IsChecked="{Binding ViewModel.IsAcceptingOrders, Mode=TwoWay}" />
                </StackPanel>

                <!-- 第二个元素：排版功能 -->
                <!-- 
            将这个StackPanel放在第二列。
            HorizontalAlignment="Right" 会让按钮靠右对齐，
            这在UI布局中通常更好看。
        -->
                <!--<StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,220,0">

                    ~1~ TextBlock通常用于显示文本，按钮不应该放在里面 @1@
                    <TextBlock
                        FontSize="18"
                        FontWeight="DemiBold"
                        Text="排版功能"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0" /> ~1~ 按钮和文字之间加点间距 @1@

                    <ui:Button
                        Appearance="Primary"
                        Click="Test"
                        Content="排版测试" />
                </StackPanel>-->
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <ui:Button
                        Command="{Binding ViewModel.ToggleSoundCommand}"
                        ToolTip="声音开关">
                        <ui:SymbolIcon Symbol="{Binding ViewModel.SoundIcon, Mode=OneWay}" />
                    </ui:Button>
                    <Separator
                        Height="16"
                        Margin="4,0,4,0" />
                    <ui:Button
                        Grid.Column="1"
                        Command="{Binding ViewModel.OpenFolderCommand, Mode=OneWay}"
                        Icon="{ui:SymbolIcon Folder24}"
                        ToolTip="稿件目录" />
                    <Separator
                        Grid.Column="3"
                        Height="16"
                        Margin="4,0,4,0" />
                    <ui:Button
                        Grid.Column="2"
                        Command="{Binding ViewModel.ToggleLightOrDarkCommand}"
                        Icon="{ui:SymbolIcon WeatherSunny24}"
                        ToolTip="切换主题" />
                    <Separator
                        Grid.Column="3"
                        Height="16"
                        Margin="4,0,4,0" />
                    <ui:Anchor
                        Grid.Column="4"
                        CommandParameter="copy"
                        Icon="{ui:SymbolIcon PersonLink28}"
                        NavigateUri="{x:Static localApp:App.FactoryManageUrl}"
                        ToolTip="管理后台" />
                    <Separator
                        Grid.Column="3"
                        Height="16"
                        Margin="4,0,4,0" />
                    <ui:Anchor
                        Grid.Column="5"
                        Margin="4,0,0,0"
                        Icon="{ui:SymbolIcon PersonFeedback24}"
                        NavigateUri="https://github.com/lepoco/wpfui/issues/new?assignees=pomianowski&amp;labels=bug,gallery&amp;template=bug_report.yaml&amp;title=WPF+UI+Gallery+Problem"
                        ToolTip="反馈" />
                </StackPanel>
            </Grid>
        </Border>
        <Border
            Grid.Row="1"
            Margin="0,12,0,0"
            Padding="12"
            Background="{ui:ThemeResource ApplicationBackgroundBrush}"
            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <ItemsControl ItemsSource="{Binding ViewModel.DateFilterButtons}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton
                            Margin="0,0,8,0"
                            Content="{Binding DisplayText}"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            Command="{Binding DataContext.ViewModel.DateFilterCommand, RelativeSource={RelativeSource AncestorType=local:DashboardPage}}"
                            CommandParameter="{Binding Value}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <Border
            Grid.Row="2"
            Margin="0 12 0 0"
            Background="{ui:ThemeResource ApplicationBackgroundBrush}"
            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <ui:DataGrid
                x:Name="ProductBatchDataGrid"
                SelectionChanged="ProductBatchDataGrid_OnSelectionChanged"
                SelectionMode="Extended"
                ItemsSource="{Binding ViewModel.ProductBatchCollection, Mode=TwoWay}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                IsReadOnly="True"
                RowStyle="{StaticResource DataGridRowStyleWithContextMenu}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="生产计划">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource SelectableReadOnlyCellStyle}" 
                                         Text="{Binding ProduceBatchNum}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="项总数" Binding="{Binding ProduceBatchItemProcess, Mode=OneWay}"></DataGridTextColumn>
                    <DataGridTextColumn Header="数据加载" Binding="{Binding DataDownloadProgress, Mode=OneWay}"></DataGridTextColumn>
                    <DataGridTextColumn Header="图片下载" Binding="{Binding ImgDownloadProgress, Mode=OneWay}"></DataGridTextColumn>
                    <DataGridTextColumn Header="印花渲染" Binding="{Binding PiecePrintProgress, Mode=OneWay}"></DataGridTextColumn>
                    <!--<DataGridTextColumn Header="排版完成" Binding="{Binding LayoutCreateProgress, Mode=OneWay}"></DataGridTextColumn>-->
                    <DataGridTemplateColumn Header="审核时间">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource SelectableReadOnlyCellStyle}" 
                                         Text="{Binding CheckTime, StringFormat='yy年M月d日 HH:mm'}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="接收时间">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource SelectableReadOnlyCellStyle}" 
                                         Text="{Binding FactoryGetTime, StringFormat='yy年M月d日 HH:mm'}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="批次状态" Binding="{Binding ProduceBatchStatus}"></DataGridTextColumn>
                    <DataGridTemplateColumn Header="操作">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="查看批次详情"
                                        Command="{Binding DataContext.ViewModel.OpenProduceItemWindowCommand, RelativeSource={RelativeSource AncestorType={x:Type local:DashboardPage}}}"
                                        CommandParameter="{Binding}"/>
                                    <Grid Margin="4,0,0,0">
                                        <Button Content="去印刷"
                                                Command="{Binding DataContext.ViewModel.GoToPrintCommand, RelativeSource={RelativeSource AncestorType={x:Type local:DashboardPage}}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ProduceBatchStatus}" Value="{x:Static constant:ProduceBatchStatus.全部无需印花}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <TextBlock Text="无需印花" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ProduceBatchStatus}" Value="{x:Static constant:ProduceBatchStatus.全部无需印花}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </ui:DataGrid>
        </Border>
    </Grid>
</Page>